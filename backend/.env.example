# ── Flask ──────────────────────────────────────────────────────────────
# Config profile: development | testing | production
FLASK_CONFIG=development
# Flask session/signing key (generate a real one for anything non-local)
SECRET_KEY=change-me
# Port used by `python run.py`
PORT=5000

# ── Database ───────────────────────────────────────────────────────────
# SQLite for quick local runs, or PostgreSQL, e.g.:
# postgresql+psycopg://eduledger:eduledger@localhost:5432/eduledger
DB_URL=sqlite:///eduledger.db

# ── Blockchain (local Hardhat network) ────────────────────────────────
HARDHAT_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Addresses are printed by `npm run deploy:local` (contracts/README flow)
ROLE_REGISTRY_CONTRACT_ADDRESS=
# Filled in when the MVP module contracts are deployed:
ATTENDANCE_ENGINE_CONTRACT_ADDRESS=
AUDIT_TRAIL_CONTRACT_ADDRESS=
WORKLOAD_LEDGER_CONTRACT_ADDRESS=

# ── IPFS (local Kubo node or free pinning service) ────────────────────
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRES_HOURS=12

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
