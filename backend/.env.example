# ── Flask ──────────────────────────────────────────────────────────────
# Config profile: development | testing | production
FLASK_CONFIG=development
# Flask session/signing key (generate a real one for anything non-local)
SECRET_KEY=change-me
# Port used by `python run.py`
PORT=5000

# ── Database ───────────────────────────────────────────────────────────
# SQLite for quick local runs, or PostgreSQL, e.g.:
# postgresql+psycopg://eduledger:eduledger@localhost:5432/eduledger
# (relative SQLite paths resolve to backend/instance/)
DB_URL=sqlite:///eduledger.db

# ── Redis (Phase 1.2a) ─────────────────────────────────────────────────
# SocketIO message queue for the live attendance panel and the store for
# wrong numeric-code attempt counters. Leave empty to run without Redis:
# events stay inside one server process and the counter falls back to
# process memory.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Attendance sessions (Module 1) ──────────────────────────────────
# Seconds between QR nonce rotations for active sessions. The 6-digit
# numeric code is derived from the nonce (HMAC with SECRET_KEY), so it
# rotates in sync.
ATTENDANCE_ROTATION_SECONDS=10
# Faculty may start at most this many minutes before the scheduled start
SESSION_START_GRACE_MINUTES=5
# Uploaded weekday/time values are local wall times in this IANA timezone
TIMETABLE_TIMEZONE=Asia/Karachi
# Set false to disable the background nonce-rotation job (tests, scripts)
SCHEDULER_ENABLED=true

# ── Blockchain (local Hardhat network) ────────────────────────────────
HARDHAT_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Addresses are printed by `npm run deploy:local` (contracts/README flow)
ROLE_REGISTRY_CONTRACT_ADDRESS=
# Filled in when the MVP module contracts are deployed:
ATTENDANCE_ENGINE_CONTRACT_ADDRESS=
AUDIT_TRAIL_CONTRACT_ADDRESS=
WORKLOAD_LEDGER_CONTRACT_ADDRESS=
# Printed by `npm run deploy:governance` (run it LAST so the four addresses
# above never change)
GOVERNANCE_CONTRACT_ADDRESS=

# ── IPFS (local Kubo node or free pinning service) ────────────────────
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
# Free-tier fallback when the local daemon is down (optional): upload API
# bearer token from https://web3.storage - leave empty to disable the fallback
WEB3_STORAGE_TOKEN=

# ── Auth ───────────────────────────────────────────────────────────────
# Signing key for API tokens - use a random value of at least 32 bytes
JWT_SECRET=dev-jwt-secret-please-change-me-32-chars-min
JWT_EXPIRES_HOURS=12
# Institutional email domain required for faculty and student registration
# (placeholder - set to real domain before production use)
INSTITUTION_EMAIL_DOMAIN=gcu.edu.pk

# ── Identity verification & attendance scan (Module 1) ─────────
# Cosine similarity threshold for a face match (0.85 suits the built-in demo
# embedder; use ~0.6 with face_recognition 128-d encodings)
FACE_MATCH_THRESHOLD=0.85
# Verification token lifetime (seconds) issued by /attendance/verify-identity
VERIFICATION_TOKEN_SECONDS=30
# Face embedding provider: auto | demo | face_recognition
# (auto = face_recognition when installed, else the built-in demo embedder)
FACE_EMBEDDING_PROVIDER=auto
# Backend transaction signer (must hold BACKEND_ROLE on AttendanceLedger).
# Default = Hardhat account #0, the PUBLIC local test key - LOCAL TESTING ONLY.
BACKEND_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Optional: explicit path to contracts/deployed/AttendanceLedger.json
# (default: <repo>/contracts/deployed/AttendanceLedger.json)
# ATTENDANCE_LEDGER_ARTIFACT=

# ── Record audit trail (Module 2) ────────────────────────────────────
# Role signers for RecordAuditTrail - must hold INSTRUCTOR_ROLE / HOD_ROLE /
# EXAM_CONTROLLER_ROLE (granted to the labeled accounts in
# contracts/deployed/accounts.json by `npm run deploy:audit-trail`).
# Defaults = Hardhat accounts #1-#3, PUBLIC local test keys - LOCAL TESTING ONLY.
# INSTRUCTOR_SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# HOD_SIGNER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# EXAM_CONTROLLER_SIGNER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
# Optional: explicit path to contracts/deployed/RecordAuditTrail.json
# (default: <repo>/contracts/deployed/RecordAuditTrail.json)
# AUDIT_TRAIL_ARTIFACT=

# ── Faculty workload ledger (Module 3) ──────────────────────────────
# Minutes after a class's startTime with no SessionLog before the
# background job auto-flags it UNCONDUCTED on-chain (15 = the PRD grace
# period; set to 1 to exercise the auto-flag without waiting)
UNCONDUCTED_THRESHOLD_MINUTES=15
# Lifetime of substitute authorization tokens, in minutes
SUBSTITUTE_TOKEN_MINUTES=30
# Optional: explicit path to contracts/deployed/WorkloadLedger.json
# (default: <repo>/contracts/deployed/WorkloadLedger.json)
# WORKLOAD_LEDGER_ARTIFACT=

# ── Governance registry / admin bootstrap (Phase 0.5) ─────────────────
# Shared secret required by the one-time POST /api/v1/auth/bootstrap/admin
# call (there is no ADMIN user yet, so the secret plus the permanent on-chain
# lock are the only protection). No default: leave it empty and the route is
# disabled. Generate a random value; real deployments must set their own.
BOOTSTRAP_ADMIN_SECRET=dev-bootstrap-secret-change-me
# Address locked as the system root by GovernanceRegistry.lockRoot().
# Default = Hardhat account #5, unused by the other modules' signers
# (accounts #0-#4) - LOCAL DEMO ONLY; real deployments must set their own.
ADMIN_ROOT_ADDRESS=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
# Optional: explicit path to contracts/deployed/GovernanceRegistry.json
# (default: <repo>/contracts/deployed/GovernanceRegistry.json)
# GOVERNANCE_REGISTRY_ARTIFACT=

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
