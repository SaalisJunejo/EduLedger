{
  "name": "eduledger-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "EduLedger smart contracts - Hardhat project with OpenZeppelin, targeting the local Hardhat network",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "compile": "hardhat compile",
    "node": "hardhat node",
    "test": "hardhat test",
    "deploy:local": "hardhat run ../scripts/deploy.js --network localhost",
    "seed:local": "hardhat run ../scripts/seed.js --network localhost",
    "seed:accounts": "hardhat run scripts/seed-accounts.js",
    "deploy:audit-trail": "hardhat run scripts/deploy.js --network localhost",
    "deploy:attendance": "hardhat run scripts/deploy-attendance.js --network localhost"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17"
  }
}
