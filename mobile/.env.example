# Copy this file to .env. Replace the example IPv4 address with your PC's LAN IP
# (run ipconfig in PowerShell; use the active Wi-Fi adapter's IPv4 Address).
# Keep /api/v1. A physical phone cannot reach your PC via localhost/127.0.0.1.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1

# EXPO_PUBLIC_* values are bundled into the app. Never put tokens/secrets here.
# Restart Expo after changing this value. HTTP is for trusted local development;
# use HTTPS for deployed environments.
